# ── Telegram (comma-separated for multiple channels) ─────────────────────────
TELEGRAM_CHANNELS=@Anime_Naruto_Art_AOT,@OnePieceArtwork
SCRAPE_INTERVAL_MINUTES=10

# ── Pinterest ─────────────────────────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
# Board ID is optional (the bot will auto-detect your Anime board)
PINTEREST_BOARD_ID=

# ── Amazon Affiliate (India) ──────────────────────────────────────────────────
AMAZON_AFFILIATE_TAG=aniflexindia-21

# ── Gemini AI (optional — enables smart captions) ────────────────────────────
# Free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Scheduler ────────────────────────────────────────────────────────────────
POST_DELAY_MINUTES=10
MAX_POSTS_PER_DAY=15
