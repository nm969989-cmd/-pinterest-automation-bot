# ── Telegram Scraper ─────────────────────────────────────────────────────────
# Comma-separated list of channels to scrape anime images from
TELEGRAM_CHANNELS=@Anime_Naruto_Art_AOT,@OnePieceArtwork
SCRAPE_INTERVAL_MINUTES=10

# ── Pinterest ─────────────────────────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
# Default board ID (fallback if genre-specific board not set)
PINTEREST_BOARD_ID=

# ── Multi-Board Routing (optional — leave blank to use PINTEREST_BOARD_ID) ────
# Get board IDs from Pinterest API or from the board URL on pinterest.com
# e.g. pinterest.com/yourusername/shonen-anime-art/ -> use the board ID from API
BOARD_ID_SHONEN=       # Action/battle anime (Demon Slayer, Naruto, AOT, MHA)
BOARD_ID_ISEKAI=       # Isekai anime (Re:Zero, SAO, Overlord, Konosuba)
BOARD_ID_ROMANCE=      # Romance/slice-of-life (Your Name, Toradora, Horimiya)
BOARD_ID_HORROR=       # Horror/dark anime (Tokyo Ghoul, Parasyte, Another)
BOARD_ID_MECHA=        # Mecha/robot anime (Evangelion, Gurren Lagann)
BOARD_ID_SPORTS=       # Sports anime (Haikyuu, Kuroko, Blue Lock)
BOARD_ID_FANTASY=      # Fantasy/other (Death Note, Steins Gate, Violet Evergarden)
BOARD_ID_GENERAL=      # Default fallback board (if unset, uses PINTEREST_BOARD_ID)

# ── Make.com Webhook (bypass Pinterest API review — instant public pins!) ─────
# Create a scenario in Make.com: Custom Webhook -> Pinterest: Create a Pin
# The webhook payload includes: title, description, link, image_url, board_id
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id_here

# Auto-post mode: true = fully automatic, false = Telegram approval button needed
AUTO_POST_MODE=true

# ── Amazon Affiliate (India) ──────────────────────────────────────────────────
# Your Amazon Associates affiliate tag (get from affiliate-program.amazon.in)
AMAZON_AFFILIATE_TAG=yourname-21

# ── Amazon PA-API v5 (Product Advertising API) — Optional but Recommended ────
# Replaces the fragile HTML scraper with Amazon's official product search API.
# Without these, the bot scrapes Amazon.in HTML (may break if Amazon changes layout).
# With these, ASIN lookup is 100% reliable and never gets blocked.
#
# How to get credentials (5 minutes):
#   1. Go to: https://affiliate-program.amazon.in
#   2. Click: Tools → Product Advertising API
#   3. Click: "Manage Your Credentials" → Create Access Key
#   4. Copy the Access Key ID and Secret Access Key below
#
# Note: PA-API requires at least 3 qualifying affiliate sales to stay active.
AMAZON_PA_API_KEY=your_access_key_id_here
AMAZON_PA_API_SECRET=your_secret_access_key_here
AMAZON_PA_API_TAG=yourname-21   # Usually same as AMAZON_AFFILIATE_TAG

# ── OpenRouter Vision AI (FREE) ───────────────────────────────────────────────
# Enables vision AI — bot actually SEES the anime image for better captions
# Free key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Gemini AI (optional fallback) ────────────────────────────────────────────
# Free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Telegram Control Bot ──────────────────────────────────────────────────────
# Create a bot at @BotFather, get the token
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat ID (send /start to your bot to get it)
TELEGRAM_ADMIN_CHAT_ID=

# ── JSONBin.io Cloud Persistence (survives Render restarts) ───────────────────
# Free account at jsonbin.io — stores queue/state in cloud
JSONBIN_API_KEY=
JSONBIN_BIN_ID=

# ── Cloudinary (optional image host backup) ───────────────────────────────────
# Free account at cloudinary.com — 25GB free storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Scheduler ────────────────────────────────────────────────────────────────
POST_DELAY_MINUTES=60
MAX_POSTS_PER_DAY=3

# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to false to go LIVE (pins will actually be posted to Pinterest)
DRY_RUN=true
