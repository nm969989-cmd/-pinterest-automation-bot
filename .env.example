# ── Telegram Scraper ─────────────────────────────────────────────────────────
# Comma-separated list of channels to scrape anime images from
TELEGRAM_CHANNELS=@Anime_Naruto_Art_AOT,@OnePieceArtwork
SCRAPE_INTERVAL_MINUTES=10

# ── Pinterest ─────────────────────────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
# Default board ID — (Optional when using Make.com)
# If blank, Make.com posts to whatever board is selected in your Make scenario.
# IMPORTANT: Make sure the Pinterest board setting "Keep this board secret" is OFF (Public)!
PINTEREST_BOARD_ID=

# ── Multi-Board Routing (optional — leave blank to use PINTEREST_BOARD_ID) ────
# Get board IDs from Pinterest API or from the board URL on pinterest.com
# e.g. pinterest.com/yourusername/shonen-anime-art/ -> use the board ID from API
BOARD_ID_SHONEN=       # Action/battle anime (Demon Slayer, Naruto, AOT, MHA)
BOARD_ID_ISEKAI=       # Isekai anime (Re:Zero, SAO, Overlord, Konosuba)
BOARD_ID_ROMANCE=      # Romance/slice-of-life (Your Name, Toradora, Horimiya)
BOARD_ID_HORROR=       # Horror/dark anime (Tokyo Ghoul, Parasyte, Another)
BOARD_ID_MECHA=        # Mecha/robot anime (Evangelion, Gurren Lagann)
BOARD_ID_SPORTS=       # Sports anime (Haikyuu, Kuroko, Blue Lock)
BOARD_ID_FANTASY=      # Fantasy/other (Death Note, Steins Gate, Violet Evergarden)
BOARD_ID_GENERAL=      # Default fallback board (if unset, uses PINTEREST_BOARD_ID)

# ── Make.com Webhook (bypass Pinterest API review — instant public pins!) ─────
# Create a scenario in Make.com: Custom Webhook -> Pinterest: Create a Pin
# The webhook payload includes: title, description, link, image_url, board_id
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id_here

# Auto-post mode: true = fully automatic, false = Telegram approval button needed
AUTO_POST_MODE=true

# ── Amazon Affiliate (India) ──────────────────────────────────────────────────
# Your Amazon Associates affiliate tag (get from affiliate-program.amazon.in)
AMAZON_AFFILIATE_TAG=yourname-21

# ── Amazon PA-API v5 (Product Advertising API) — Optional but Recommended ────
# Replaces the fragile HTML scraper with Amazon's official product search API.
# Without these, the bot scrapes Amazon.in HTML (may break if Amazon changes layout).
# With these, ASIN lookup is 100% reliable and never gets blocked.
#
# How to get credentials (5 minutes):
#   1. Go to: https://affiliate-program.amazon.in
#   2. Click: Tools → Product Advertising API
#   3. Click: "Manage Your Credentials" → Create Access Key
#   4. Copy the Access Key ID and Secret Access Key below
#
# Note: PA-API requires at least 3 qualifying affiliate sales to stay active.
AMAZON_PA_API_KEY=your_access_key_id_here
AMAZON_PA_API_SECRET=your_secret_access_key_here
AMAZON_PA_API_TAG=yourname-21   # Usually same as AMAZON_AFFILIATE_TAG

# ── Displate Affiliate (Metal Wall Art Posters — 15-25% Commission) ─────────
# Get partner tag at https://displate.com (or leave blank for clean search links)
DISPLATE_AFFILIATE_TAG=
DISPLATE_ENABLED=true

# ── Link Click Tracking (View Clicks & Estimated Earnings in Telegram) ───────
# Set this to your Render service public URL (e.g. https://pinterest-bot.onrender.com).
# When set, pins link to your bot's redirect URL, allowing real-time click tracking
# and estimated earnings breakdown inside Telegram (/clicks and /analytics)!
# If left blank, pins will link directly to Amazon.in without click interception.
APP_BASE_URL=
CLICK_NOTIFICATION=true   # Instant Telegram notification when someone clicks a link

# ── OpenRouter Vision AI (FREE) ───────────────────────────────────────────────
# Enables vision AI — bot actually SEES the anime image for better captions
# Free key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Gemini AI (optional fallback) ────────────────────────────────────────────
# Free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Telegram Control Bot ──────────────────────────────────────────────────────
# Create a bot at @BotFather, get the token
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat ID (send /start to your bot to get it)
TELEGRAM_ADMIN_CHAT_ID=

# ── JSONBin.io Cloud Persistence (survives Render restarts) ───────────────────
# Free account at jsonbin.io — stores queue/state in cloud
JSONBIN_API_KEY=
JSONBIN_BIN_ID=

# ── Cloudinary (optional image host backup) ───────────────────────────────────
# Free account at cloudinary.com — 25GB free storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Scheduler ────────────────────────────────────────────────────────────────
POST_DELAY_MINUTES=60
MAX_POSTS_PER_DAY=3

# ── Daily Performance Digest (Telegram Summary) ─────────────────────────────
# Automatically sends a performance & health report to your Telegram admin chat
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME=21:00   # 24-hr IST format (9:00 PM IST)

# ── Viral Pin Surge Radar (Traffic Spikes & Spinoff Engine) ──────────────────
VIRAL_RADAR_ENABLED=true
VIRAL_SURGE_MIN_VISITS=5
VIRAL_ALERT_COOLDOWN_HOURS=12
VIRAL_AUTO_SPINOFF=false

# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to false to go LIVE (pins will actually be posted to Pinterest)
DRY_RUN=true

# ── Shutterstock Contributor ──────────────────────────────────────────────────
# METHOD 0: Make.com Webhook (EASIEST — no API token needed, same as Pinterest!)
# Setup (5 min): https://make.com -> New Scenario -> Webhook + Shutterstock module
# Same way your Pinterest bot works with MAKE_WEBHOOK_URL!
SHUTTERSTOCK_MAKE_WEBHOOK_URL=

# METHOD 1: API Upload (requires approved API access)
# Get token at: https://www.shutterstock.com/account/developers/apps
# Steps: Create App -> Generate OAuth token with scope: contributors.upload
SHUTTERSTOCK_ACCESS_TOKEN=

# FTP credentials (needed for Method 0 AND Method 2 — always get these first!)
# Get FTP credentials from: https://submit.shutterstock.com -> Profile -> FTP
SHUTTERSTOCK_FTP_HOST=ftp.shutterstock.com
SHUTTERSTOCK_FTP_USER=
SHUTTERSTOCK_FTP_PASS=

# ── Adobe Stock Contributor ──────────────────────────────────────────────────
# Portal: https://contributor.stock.adobe.com
# Option A: Make.com Webhook (Account 2)
ADOBE_MAKE_WEBHOOK_URL=
# Option B: Direct FTP / SFTP (Contributor Portal -> Upload -> SFTP tab)
ADOBE_FTP_HOST=ftp.adobestock.com
ADOBE_FTP_USER=
ADOBE_FTP_PASS=

# ── Freepik Contributor ──────────────────────────────────────────────────────
# Portal: https://contributor.freepik.com
# How to get: Contributor Portal -> Click "Upload" -> Select "FTP" tab
# Freepik automatically indexes Title and Keywords embedded in JPEG images!
FREEPIK_FTP_HOST=ftp.contributor.freepik.com
FREEPIK_FTP_PORT=21
FREEPIK_FTP_USER=
FREEPIK_FTP_PASS=

# ── Dreamstime Contributor ───────────────────────────────────────────────────
# Portal: https://www.dreamstime.com/uploadfile
# FTP Host: upload.dreamstime.com
DREAMSTIME_FTP_HOST=upload.dreamstime.com
DREAMSTIME_FTP_PORT=21
DREAMSTIME_FTP_USER=
DREAMSTIME_FTP_PASS=

# ── Depositphotos Contributor ────────────────────────────────────────────────
# Portal: https://depositphotos.com
# FTP Host: ftp.depositphotos.com
DEPOSITPHOTOS_FTP_HOST=ftp.depositphotos.com
DEPOSITPHOTOS_FTP_PORT=21
DEPOSITPHOTOS_FTP_USER=
DEPOSITPHOTOS_FTP_PASS=

# ── 123RF Contributor ────────────────────────────────────────────────────────
# Portal: https://www.123rf.com/contributors/
# FTP Host: ftp.123rf.com
RF123_FTP_HOST=ftp.123rf.com
RF123_FTP_PORT=21
RF123_FTP_USER=
RF123_FTP_PASS=

# ── Global Stock Post Limits ─────────────────────────────────────────────────
# Max posts per day per stock platform (default 5)
STOCK_MAX_POSTS_PER_DAY=5

# ── Are.na Visual Curation (cross-post Pinterest pins to Are.na board) ────────
# Are.na = Pinterest-style visual bookmarking with a free public REST API
# Step 1: Sign up at https://www.are.na
# Step 2: Get your token at https://dev.are.na/oauth/applications → New Application
#         Name: Pinterest Bot | Redirect URI: https://localhost
# Step 3: Copy your Personal Access Token below (grants read+write to your account)
# Step 4: Create a channel at are.na → copy the channel name from the URL
#         e.g. are.na/manoj-muthelyrics/aesthetic-inspiration → slug = aesthetic-inspiration
# Step 5: Set ARENA_ENABLED=true to start cross-posting
ARENA_ACCESS_TOKEN=your_arena_personal_access_token_here
ARENA_CHANNEL_SLUG=aesthetic-inspiration
ARENA_ENABLED=false

# ── ImageKit.io Global CDN & Media Storage (Mumbai, India) ────────────────────
# Step 1: Sign up at https://imagekit.io
# Step 2: Get API Keys at https://imagekit.io/dashboard/developer/api-keys
# Step 3: Set IMAGEKIT_ENABLED=true to enable cross-posting to ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_ENABLED=false

# ── ImgPile Dedicated Image Uploading ─────────────────────────────────────────
# Step 1: Create an account on https://imgpile.com/settings
# Step 2: Under API keys, enter key name (e.g. PinterestBot) and click Create key
# Step 3: Paste the generated Bearer key below
IMGPILE_API_KEY=your_imgpile_api_key_here
IMGPILE_ENABLED=false


# ── Bluesky Cross-Post (AT Protocol visual feed) ─────────────────────────────
# Step 1: Log in at https://bsky.app
# Step 2: Go to Settings → Privacy & Security → App Passwords
# Step 3: Click "Add App Password", name it "Pinterest Bot"
# Step 4: Paste your handle (e.g. yourname.bsky.social) and App Password below
# Step 5: Set BLUESKY_ENABLED=true to start cross-posting
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_ENABLED=false

# ── Raindrop.io Visual Bookmarking (Pinterest-like boards & public collections) ──
# Step 1: Log in at https://app.raindrop.io
# Step 2: Go to Settings → Integrations → For Developers → Create new app
# Step 3: Click the app → "Create test token" and paste below
# Step 4: Set RAINDROP_ENABLED=true
RAINDROP_ACCESS_TOKEN=
RAINDROP_COLLECTION_ID=
RAINDROP_ENABLED=false

# ── Mastodon (Fediverse) Social Microblogging ────────────────────────────────
# Step 1: Log in at https://mastodon.social (or your Mastodon instance)
# Step 2: Go to Preferences (Settings) → Development → New application
# Step 3: Name the app (e.g. "Anime Poster Bot"), leave read & write checked, click Submit
# Step 4: Click the newly created app and copy "Your access token"
# Step 5: Set MASTODON_ENABLED=true
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
MASTODON_ENABLED=false

# ── DeviantArt Art Community Cross-Post ───────────────────────────────────────
# Step 1: Sign up / log in at https://www.deviantart.com
# Step 2: Register app at https://www.deviantart.com/developers/apps
#         Name: Anime Auto Poster | Redirect URI: http://localhost:8080
#         Scopes: check 'stash', 'publish', 'browse'
# Step 3: Copy Client ID and Client Secret below
# Step 4: Run 'python get_deviantart_token.py' to generate your OAuth2 tokens
# Step 5: Set DEVIANTART_ENABLED=true
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=
DEVIANTART_ACCESS_TOKEN=
DEVIANTART_REFRESH_TOKEN=
DEVIANTART_ENABLED=false

# ── Pixelfed (Fediverse Photo Sharing) Cross-Post ───────────────────────────
# Step 1: Log in at https://pixelfed.social (or your preferred Pixelfed instance)
# Step 2: Go to Settings → Applications (or https://pixelfed.social/settings/applications)
# Step 3: Under "Personal Access Tokens", click "Create New Token"
# Step 4: Name it "Pinterest Bot", check 'read' and 'write' scopes, click "Create"
# Step 5: Copy the generated token and paste below
# Step 6: Set PIXELFED_ENABLED=true
PIXELFED_INSTANCE_URL=https://pixelfed.social
PIXELFED_ACCESS_TOKEN=
PIXELFED_ENABLED=false

# ── Freeimage.host Dedicated Image Uploading ────────────────────────────────
# Step 1: Account at https://freeimage.host
# Step 2: Use your own API key from freeimage.host
# Step 3: Set FREEIMAGE_ENABLED=true
FREEIMAGE_API_KEY=
FREEIMAGE_ENABLED=true

# ── ImgBB Dedicated Image Uploading ──────────────────────────────────────────
# Step 1: Account at https://imgbb.com
# Step 2: Get API key at https://api.imgbb.com
# Step 3: Set IMGBB_ENABLED=true
IMGBB_API_KEY=
IMGBB_ENABLED=true

# ── Imghippo Dedicated Image Uploading ───────────────────────────────────────
# Step 1: Account at https://imghippo.com
# Step 2: Get API key at https://imghippo.com/dashboard
# Step 3: Set IMGHIPPO_ENABLED=true
IMGHIPPO_API_KEY=00f11d3e65f34df60a3cf9e47ecf7453
IMGHIPPO_ENABLED=true

# ── Wallhaven.cc Anime Wallpaper Platform ──────────────────────────────────
# World's premier anime & 4K wallpaper community (DA 75+)
# Step 1: Account at https://wallhaven.cc
# Step 2: Get API key at https://wallhaven.cc/settings/account
# Step 3: Set WALLHAVEN_ENABLED=true
WALLHAVEN_API_KEY=
WALLHAVEN_USERNAME=animizing
WALLHAVEN_ENABLED=true

# ── Telegram Watermark Cleaner & Inpainter (Zero Stock Rejections) ───────────
# Automatically detects and erases @channel_name stamps and promotional text
# from corner zones before Pinterest and stock uploads using OpenCV inpainting.
WATERMARK_CLEANER_ENABLED=true

# ── 80/20 Organic Trust Ratio (Pinterest Ban & Shadowban Protection) ─────────
# Automatically intersperses 1 organic aesthetic pin for every 4 affiliate pins (20%).
# Organic pins omit #ad/#affiliate disclosures and link to your Pinterest profile/board,
# dramatically boosting account authority and preventing commercial spam flags.
ORGANIC_TRUST_ENABLED=true
ORGANIC_TRUST_RATIO=0.20
ORGANIC_PIN_LINK=

# ── A/B Title Split Testing ──────────────────────────────────────────────────
# Set true to post 2 title variants per image and auto-declare winner based on CTR
AB_TESTING_ENABLED=false
AB_DECISION_HOURS=48             # Hours before comparing CTR and picking winner
AB_MIN_VISITS=3                  # Minimum visits required before declaring winner

# ── Revenue Tracking (Estimated Earnings) ────────────────────────────────────
# Computes estimated affiliate earnings based on affiliate click counts
REVENUE_TRACKING_ENABLED=true
REVENUE_PER_CLICK_INR=25.0       # Estimated INR earned per affiliate click

# ── Weekly Performance Report ────────────────────────────────────────────────
# Auto-sends a rich Sunday performance report to admin via Telegram
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_TIME=09:00         # IST HH:MM (24-hour)
WEEKLY_REPORT_DAY=6              # 6 = Sunday (Mon=0 ... Sun=6)

# ── Ghost Pin Reviver ────────────────────────────────────────────────────────
# Detects pins with 0 bridge visits after N days and re-queues with new SEO titles
GHOST_REVIVER_ENABLED=true
GHOST_REVIVER_MIN_AGE_DAYS=7     # Days old before declaring ghost pin
GHOST_REVIVER_MAX_BATCH=3        # Max pins to revive per daily run
